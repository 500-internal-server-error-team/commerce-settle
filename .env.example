# Run python3 scripts/init_env.py; missing passwords, keys and the auth epoch are generated locally.
COMPOSE_PROJECT_NAME=commerce-settle
APP_DEV_FIXTURES_ENABLED=false
APP_NOTIFICATIONS_CONSUMER_ENABLED=false
APP_NOTIFICATIONS_WORKER_ENABLED=false
APP_NOTIFICATIONS_MOCK_SEED=67
APP_NOTIFICATIONS_MOCK_DELAY_MS=0
APP_NOTIFICATIONS_MOCK_TEMPORARY_FAILURE_PERMILLE=0
APP_NOTIFICATIONS_MOCK_PERMANENT_FAILURE_PERMILLE=0
APP_NOTIFICATIONS_MOCK_RESPONSE_LOSS_PERMILLE=0
DEV_FIXTURE_PASSWORD=
GATEWAY_PORT=8080
POSTGRES_PASSWORD=
COMMERCE_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
SETTLEMENT_DB_PASSWORD=
FINANCE_MOCK_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
KAFKA_UI_PORT=8081
REDIS_PASSWORD=
GATEWAY_REDIS_PASSWORD=
COMMERCE_REDIS_PASSWORD=
PAYMENT_REDIS_PASSWORD=
SETTLEMENT_REDIS_PASSWORD=
FINANCE_MOCK_REDIS_PASSWORD=
AUTH_SESSION_EPOCH=
# 승인한 Redis run_id. python3 scripts/sync_redis_run_id.py가 현재 값을 넣고 바뀌면 세대도 함께 바꾼다.
AUTH_REDIS_RUN_ID=
AUTH_RATE_LIMIT_HMAC_KEY=
AUTH_RESET_DELIVERY_KEY=
ADDRESS_ENCRYPTION_KEY=
# 내부 호출 자격 <대상>_<발신자>_CREDENTIAL. 교체 중에만 받는 쪽의 _PREVIOUS에 이전 값을 둔다.
COMMERCE_GATEWAY_CREDENTIAL=
COMMERCE_GATEWAY_CREDENTIAL_PREVIOUS=
PAYMENT_GATEWAY_CREDENTIAL=
PAYMENT_GATEWAY_CREDENTIAL_PREVIOUS=
SETTLEMENT_GATEWAY_CREDENTIAL=
SETTLEMENT_GATEWAY_CREDENTIAL_PREVIOUS=
FINANCE_MOCK_SETTLEMENT_CREDENTIAL=
FINANCE_MOCK_SETTLEMENT_CREDENTIAL_PREVIOUS=
FINANCE_MOCK_PAYMENT_CREDENTIAL=
FINANCE_MOCK_PAYMENT_CREDENTIAL_PREVIOUS=
ZIPKIN_PORT=9411
TRACING_SAMPLING_PROBABILITY=0.1

# 업무 시나리오도 실행하려면 fixture를 켜고 정산 일배치·지급 Worker를 끈다.
APP_DEV_FIXTURE_SCENARIOS_ENABLED=false
SETTLEMENT_DAILY_BATCH_ENABLED=true
SETTLEMENT_PAYOUT_WORKER_ENABLED=true

# 본인 카카오톡 시연 전용. 토큰·REST API 키·client secret은 이 파일에 넣지 않는다.
# compose.kakao-self.yml을 명시적으로 선택할 때만 실제 발송을 켠다.
KAKAO_SELF_DEMO_ENABLED=false
KAKAO_SELF_CREDENTIALS_DIR=
KAKAO_SELF_CREDENTIALS_FILE=
KAKAO_SELF_UID=
KAKAO_SELF_GID=
KAKAO_SELF_USER_ID=
KAKAO_SELF_APP_ID=
KAKAO_SELF_MESSAGE_LINK=
KAKAO_SELF_BUYER_IDS=
KAKAO_SELF_SELLER_IDS=
