{
  "uid": "commerce-settle-payment-worker",
  "title": "commerce-settle / Payment Worker",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "첫 선점 대기 · 평균",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(payment_queue_wait_seconds_sum{application=\"payment\",role=\"worker\"}[2m])) / sum by (queue) (rate(payment_queue_wait_seconds_count{application=\"payment\",role=\"worker\"}[2m]))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "첫 선점 대기 · p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,queue) (rate(payment_queue_wait_seconds_bucket{application=\"payment\",role=\"worker\"}[2m])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
