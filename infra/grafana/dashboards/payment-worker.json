      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(payment_processing_seconds_bucket{application=\"payment\",role=\"worker\"}[2m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
