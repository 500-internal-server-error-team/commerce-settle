        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(payment_processing_seconds_sum{application=\"payment\",role=\"worker\"}[2m])) / sum by (stage) (rate(payment_processing_seconds_count{application=\"payment\",role=\"worker\"}[2m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 4,
