          "refId": "A",
          "expr": "histogram_quantile(0.99, business:duration_bucket{window=\"$window\",operation=\"$latency_operation\"}) and on (operation,window) (business:duration_count{window=\"$window\",operation=\"$latency_operation\"} >= 10000)",
