{
  "uid": "settlement-quarantine",
  "title": "commerce-settle / Settlement quarantine",
  "schemaVersion": 40,
  "version": 1,
  "timezone": "Asia/Seoul",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "commerce-settle",
    "settlement",
    "quarantine"
  ],
  "description": "격리 기능 활성화 시 DB의 논리 작업을 관측합니다. 45초 이상 지난 표본은 상태 집계에서 제외하며 수집 없음을 0건으로 간주하지 않습니다.",
  "panels": [
    {
      "id": 1,
      "title": "최근 5분 신규 격리 원문",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_captured_recent:max",
          "legendFormat": "{{consumer}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "확인 필요 발행 작업",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_delivery_records:max{status=\"REVIEW_REQUIRED\"}",
          "legendFormat": "{{consumer}} {{kind}} {{status}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "REVIEW_REQUIRED 상태의 DLT·REPLAY 발행 작업입니다. 격리 원문 건수와 구분합니다."
    },
    {
      "id": 3,
      "title": "DLT·REPLAY 발행 작업 · 상태별 추이",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_delivery_records:max",
          "legendFormat": "{{consumer}} {{kind}} {{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "격리 발행 작업 · 도래 후 최장 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_delivery_overdue_seconds:max",
          "legendFormat": "{{consumer}} / {{kind}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "DB 관측 성공 · 인스턴스별",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement_quarantine_collection_success",
          "legendFormat": "{{consumer}} / {{role}} / {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "1은 마지막 DB 관측 성공, 0은 실패 또는 아직 관측 전입니다. 인스턴스별로 구분하고 메트릭 수집 상태는 UP과 함께 확인합니다."
    },
    {
      "id": 6,
      "title": "마지막 DB 관측 표본의 나이",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - settlement_quarantine_observed_timestamp_seconds",
          "legendFormat": "{{consumer}} / {{role}} / {{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "마지막으로 성공한 DB 관측 시각부터의 경과 초입니다. 45초 초과·미수집을 정상 0으로 해석하지 않습니다."
    },
    {
      "id": 7,
      "title": "보존 중인 격리 원문",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_originals:max",
          "legendFormat": "{{consumer}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "정산 메트릭 수집 대상 · UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"commerce-settle\",instance=\"settlement:9091\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "1은 Prometheus의 메트릭 HTTP 수집 성공, 0은 수집 실패입니다. DB 관측 성공이나 업무 정상 상태를 뜻하지 않습니다. 대상 인스턴스를 구분해 확인합니다."
    }
  ]
}
