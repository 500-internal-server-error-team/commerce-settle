{
  "uid": "settlement-quarantine",
  "title": "commerce-settle / Settlement quarantine",
  "schemaVersion": 40,
  "version": 1,
  "timezone": "Asia/Seoul",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "commerce-settle",
    "settlement",
    "quarantine"
  ],
  "description": "격리 기능 활성화 시 DB의 논리 작업을 관측합니다. 45초 이상 지난 표본은 상태 집계에서 제외하며 수집 없음을 0건으로 간주하지 않습니다.",
  "panels": [
    {
      "id": 1,
      "title": "최근 5분 신규 격리",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_captured_recent:max",
          "legendFormat": "{{consumer}} {{kind}} {{status}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "소진된 발행 작업",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "settlement:quarantine_delivery_records:max{status=\"REVIEW_REQUIRED\"}",
          "legendFormat": "{{consumer}} {{kind}} {{status}}",
